generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Settings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique @default("global")
  videoUrl  String   @default("https://www.w3schools.com/html/mov_bbb.mp4")
  updatedAt DateTime @updatedAt
}

model ViewerLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  fingerprint      String
  latitude         Float?
  longitude        Float?
  userAgent        String?
  ip               String?
  screenResolution String?
  language         String?
  timezone         String?
  createdAt        DateTime @default(now())
}
